                (size 1.27 1.27))))
          (number "9"
            (effects
              (font
                (size 1.27 1.27))))))
      (symbol "74HC595_1_1"
        (rectangle
          (start -7.62 12.7)
          (end 7.62 -15.24)
          (stroke
            (width 0.254)
            (type default))
          (fill
            (type background))))
      (embedded_fonts no)))
  (text "ADC (on the HAT, via J16/J17): ADS131M04, 4 simultaneous channels, +/-1.2 V FS. Each input = 4.02k/1k divider (/5.02, +/-5 V -> +/-1.0 V) + 10 nF (~20 kHz).\nCH0 = V DC monitor, CH1 = I_HI, CH2 = I_LO, CH3 = AC V monitor. Clock: Pico GP21 8.000 MHz (R47 -> J16 pin 7) or the HAT oscillator (needed with the ESP32-S3)."
    (exclude_from_sim no)
    (at 20 400 0)
    (effects
      (font
        (size 1.8 1.8)
        (bold yes))
      (justify left bottom))
    (uuid "47f44e50-0f55-470f-9142-22143f63bf6e"))
  (text "POWER: external +/-15 V bench supply (Schottky reverse protection, ferrite filtering). L7805 -> +5 V (relays, DAC, Pico VSYS).\nMCP1700 -> +3V3, split by ferrites into +3V3A (ADC analog) and +3V3D (ADC digital, oscillator, logic pull-ups)."
    (exclude_from_sim no)
    (at 20 22 0)
    (effects
      (font
        (size 1.8 1.8)
        (bold yes))
      (justify left bottom))
    (uuid "4ae78785-5107-4b4d-aea5-b4dea2a89633"))
  (text "CONTROL: Pico 2 or Waveshare ESP32-S3-ETH (socketed; same header pins) -> SPI -> U27/U28 74HC595 -> CTL0..15 -> 2x TBD62783A high-side drivers -> relay coils.\nU27 QA..QH = CTL0..7, U28 QA..QH = CTL8..15 (MOSI -> U27 -> U28). Driver channel m (KDm) is driven by CTL(15-m); the order is for routing, firmware maps it.\nRLY_OE is pulled high (595 outputs Hi-Z) until firmware loads the latches and drives it low; the 4.7k pulls set the power-up state: ON = CTL3 (1M), CTL6 (DEV), CTL8 (RE_LOCAL).\nPins (Pico GP / ESP32 IO): 4 RLY_LATCH (GP2/IO48), 5 RLY_OE (GP3/IO47), 21 AUX (GP16/IO43), 22 SYNC_IN (GP17/IO44), 24 ADC_SYNC (GP18/IO0), 25 MOSI (GP19/IO1),\n26 MISO (GP20/IO2), 27 clock (GP21 GPOUT0/IO3), 29 SCK (GP22/IO15), 31 CS_ADC (GP26/IO18), 32 CS_DAC (GP27/IO16), 34 ADC_DRDY (GP28/IO17).\nJ13 = external SPI master port (relays + HAT with the controller absent or held in reset)."
    (exclude_from_sim no)
    (at 290 382 0)
    (effects
      (font
        (size 1.8 1.8)
        (bold yes))
      (justify left bottom))
    (uuid "5e4ebd32-edc7-4083-aaf9-a0cc3f35ca3f"))
  (text "BIAS DAC (on the HAT, via J17): DAC80501M (midscale at power-up) 0..5 V -> U11:  V_DAC_BIAS = 10.05 V - 4.02*V_DAC  (+10..-10 V, 0 V at midscale).\nConnected to the summer only when K21 closes (firmware sets range first)."
    (exclude_from_sim no)
    (at 20 312 0)
    (effects
      (font
        (size 1.8 1.8)
        (bold yes))
      (justify left bottom))
    (uuid "6f27b06e-c2b4-46dc-95f7-5555ecf49338"))
  (text "Op-amp decoupling: one pair per op-amp, place at each op-amp supply pin."
    (exclude_from_sim no)
    (at 580 504.19 0)
    (effects
      (font
        (size 1.8 1.8)
        (bold yes))
      (justify left bottom))
    (uuid "71e3cec2-4e20-4097-a446-9288786342c7"))
  (text "DRIVE INPUTS: BIAS/PULSE (DC) + AC PROBE (AC-coupled, JP3 = x1 or x0.1) + on-board bias DAC (via K21),\nsummed by U9 and re-inverted by U10:  VSET = V_bias + V_dac + k*V_ac."
    (exclude_from_sim no)
    (at 20 128 0)
    (effects
      (font
        (size 1.8 1.8)
        (bold yes))
      (justify left bottom))
    (uuid "762e96a3-e2fa-44c0-920b-8daa8e4ee7a1"))
  (text "HIGH-GAIN TIA U5: WE = SUM_HI virtual ground. Ranges K1..K6 = 1k, 10k, 100k, 1M, 10M, 100M (relays on the output side).\n1 MHz C-V: use 1k and 10k only (100k and up roll off below 1 MHz). Q1/Q2 C-B junctions: low-leakage steering to the low-gain TIA U6."
    (exclude_from_sim no)
    (at 560 22 0)
    (effects
      (font
        (size 1.8 1.8)
        (bold yes))
      (justify left bottom))
    (uuid "7bac1b38-40e7-4093-81ae-ccd1ffc3f5c5"))
  (text "CONTROL AMP U1: K7 DEV = follower (CE = VSET). K8 PSTAT (K7 off) = PI loop, V_RE = VSET. K9 RE_LOCAL ties RE sense to CE_INT.\nK10 CELL connects CE_INT to the CE BNC (open = cell disconnected). Cal loads (K11/K13) are T-switched: off -> mid node grounded by K12/K14 (NC)."
    (exclude_from_sim no)
    (at 290 128 0)
    (effects
      (font
        (size 1.8 1.8)
        (bold yes))
      (justify left bottom))
    (uuid "81b7cff7-003f-492e-9f27-2b258ca09863"))
  (text "RE: U2 electrometer follower, U3 guard driver (RE BNC shell + GUARD BNC), U7 RE_MON buffer (keeps monitor and nuller load off U2).\nV_OUT BNC: K19 (NC) = DC monitor V_RE/2 (U4); VMODE on -> K20 = AC monitor x10.1, AC-coupled ~100 Hz (U8)."
    (exclude_from_sim no)
    (at 290 245 0)
    (effects
      (font
        (size 1.8 1.8)
        (bold yes))
      (justify left bottom))
    (uuid "db1e7dfc-5d58-405d-b935-a3b8162b5050"))
  (text "NULLER (vector): U12 makes -V_RE. RV1 (0..-1) -> U13 -> 100p (+910p via K17) injects -jwC.V  (C null).\nRV2 (+1..-1) -> U14 -> 220n -> 20k (2k via K18) injects G null, AC-coupled (no DC into WE). K15/K16 (NULL_EN) connect to SUM_HI."
    (exclude_from_sim no)
    (at 560 213 0)
    (effects
      (font
        (size 1.8 1.8)
        (bold yes))
      (justify left bottom))
    (uuid "efed3a09-0492-49fc-a9a4-daaff6b10600"))
